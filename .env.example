# Optional: override the default newsletter signup endpoint.
# The production build defaults to /api/newsletter (served by the Cloudflare Pages Function).
# VITE_NEWSLETTER_WORKER_URL=http://localhost:8788/api/newsletter

# Site URL used by the sitemap and IndexNow scripts.
# SITE_URL=https://kotitoimitus.com

# IndexNow API key for submitting URLs to Bing, Yandex, Naver, etc.
# INDEXNOW_API_KEY=your-indexnow-key
